# Copy to .env and adjust. Lines starting with # are ignored.

# Currency for portfolio totals
BASE_CURRENCY=EUR

# 1 = synthetic sample data, no internet needed (for trying the app out)
FLOWER_DEMO=0

# Where the app listens. Keep 127.0.0.1 unless a login is set below.
HOST=127.0.0.1
PORT=8000

# Login (HTTP basic auth). REQUIRED when the app is reachable from other machines.
FLOWER_USER=
FLOWER_PASSWORD=

# Contact address sent to SEC EDGAR in the User-Agent (their fair-access policy asks for one)
SEC_CONTACT=you@example.com

# Optional: other database location
# FLOWER_DB=/var/lib/flower/flower.db

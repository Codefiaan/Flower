# systemd unit for Ubuntu. Install:
#   sudo cp deploy/flower.service /etc/systemd/system/flower.service
#   (adjust User and WorkingDirectory below)
#   sudo systemctl daemon-reload && sudo systemctl enable --now flower
[Unit]
Description=Flower Terminal (personal finance information terminal)
After=network-online.target
Wants=network-online.target

[Service]
User=flower
WorkingDirectory=/opt/flower
EnvironmentFile=/opt/flower/.env
# yfinance keeps a small cache; put it inside the writable data folder
Environment=XDG_CACHE_HOME=/opt/flower/data/.cache
ExecStart=/opt/flower/.venv/bin/python -m backend
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/flower/data

[Install]
WantedBy=multi-user.target
